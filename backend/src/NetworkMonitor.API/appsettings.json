
{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=postgres;Port=5432;Database=networkmonitor;Username=nm_app;Password=CHANGE_ME"
  },
  "Jwt": {
    "Issuer": "NetworkMonitor.API",
    "Audience": "NetworkMonitor.Client",
    "SigningKey": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS",
    "ExpiryMinutes": 30,
    "RefreshTokenDays": 7
  },
  "Monitoring": {
    "PingIntervalSeconds": 30,
    "SnmpPollIntervalSeconds": 60,
    "PingTimeoutMs": 2000,
    "OfflineThreshold": 2,
    "HistoryRetentionDays": 30
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Notifications": {
    "Email": {
      "SmtpHost": "",
      "SmtpPort": 587,
      "Username": "",
      "Password": "",
      "FromAddress": "",
      "UseSsl": true
    },
    "Telegram": {
      "BotToken": "",
      "ChatId": ""
    }
  }
}
