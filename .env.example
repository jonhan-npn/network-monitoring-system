# ===== PostgreSQL =====
POSTGRES_USER=netmon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=netmon_db
POSTGRES_PORT=5432

# ===== ASP.NET Core =====
ASPNETCORE_ENVIRONMENT=Production

# ===== Published ports =====
# 5000 is frequently reserved/used on Windows; 5080 avoids that.
API_PORT=5080
FRONTEND_PORT=8080

# ===== JWT =====
# Generate with: openssl rand -base64 64
# Must be at least 32 bytes; the API refuses to start otherwise.
JWT_SIGNING_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_ISSUER=netmon-api
JWT_AUDIENCE=netmon-client
JWT_EXPIRY_MINUTES=30

# ===== Worker / Monitoring =====
PING_INTERVAL_SECONDS=30
SNMP_POLL_INTERVAL_SECONDS=60
SSH_INVENTORY_INTERVAL_MINUTES=15
PING_TIMEOUT_MS=2000
OFFLINE_THRESHOLD=2
HISTORY_RETENTION_DAYS=30

# ===== Email alerts (SMTP) =====
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=alerts@example.com

# ===== Telegram alerts =====
TELEGRAM_BOT_TOKEN=

# ===== Worker -> API realtime bridge =====
# Generate with: openssl rand -base64 32
REALTIME_INTERNAL_SECRET=REPLACE_WITH_A_RANDOM_INTERNAL_SECRET
