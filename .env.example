# ===== PostgreSQL =====
POSTGRES_USER=netmon
POSTGRES_PASSWORD=Admin@1234.
POSTGRES_DB=Admin@netmon_db

# ===== pgAdmin =====
PGADMIN_EMAIL=admin@netmon.local
PGADMIN_PASSWORD=Admin@netmon1234.

# ===== ASP.NET Core =====
ASPNETCORE_ENVIRONMENT=Production

# ===== JWT ===== (generate with: openssl rand -base64 64)
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_64_BYTES
JWT_ISSUER=netmon-api
JWT_AUDIENCE=netmon-client
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ===== Worker / Monitoring =====
POLL_INTERVAL_SECONDS=30

# ===== Email Alerts (SMTP) =====
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=change_me

# ===== Telegram Alerts =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Frontend =====
API_BASE_URL=http://localhost:5000
